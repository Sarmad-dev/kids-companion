{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    // Declared explicitly: this package reads `process.env`, so it depends on
    // Node's ambient globals. Stating it beats inheriting whatever @types
    // happen to be installed somewhere up the tree.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../types"
    }
  ]
}
