# =============================================================================
# kids-companion — environment variable template
# =============================================================================
# Copy to `.env` for local development:  cp .env.example .env
#
# RULES (enforced in review and by infra/scripts/check-no-secrets.mjs):
#   1. This file contains PLACEHOLDERS ONLY. Never paste a real credential here.
#   2. `.env` is gitignored. Never remove it from .gitignore.
#   3. Every variable listed here must appear in packages/config's schema. A
#      variable the schema does not know about is not read by the application.
#   4. Staging and production values live in the secret manager, never in a file.
#      See SECURITY.md#secret-management.
#   5. Anything prefixed EXPO_PUBLIC_ or NEXT_PUBLIC_ is COMPILED INTO THE CLIENT
#      BUNDLE and is world-readable. Never put a secret behind those prefixes.
#
# Full reference, including which service owns each variable, the failure mode
# when it is missing, and rotation cadence: docs/ENVIRONMENT.md
# =============================================================================


# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
# NODE_ENV drives framework behaviour only. APP_ENV drives OUR behaviour
# (which secrets, which safety thresholds, whether analytics is live).
NODE_ENV=development                       # development | test | production
APP_ENV=local                              # local | ci | development | staging | production
LOG_LEVEL=debug                            # trace | debug | info | warn | error | fatal
SERVICE_NAME=kids-companion-api
SERVICE_VERSION=0.0.0                      # injected from git SHA in CI


# -----------------------------------------------------------------------------
# API server (apps/api)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
API_PUBLIC_URL=http://localhost:8080
API_REQUEST_TIMEOUT_MS=30000
API_BODY_LIMIT_BYTES=10485760              # 10 MiB — sized for a single audio upload
API_TRUST_PROXY=false                      # true only when behind a known load balancer

# Comma-separated exact origins. No wildcards in staging or production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081


# -----------------------------------------------------------------------------
# Database — Supabase Postgres
# -----------------------------------------------------------------------------
# SUPABASE_URL and SUPABASE_ANON_KEY are safe to expose to clients.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-me-anon-key

# SERVICE ROLE KEY BYPASSES ROW LEVEL SECURITY. Server-side only. Never ship to
# a client bundle. Loading it in any package other than apps/api is a bug.
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role-key

# Direct Postgres connection, used by migrations and the connection pool.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_SSL_MODE=disable                  # disable locally; `require` everywhere else
# A root certificate for a database whose chain the system does not trust: a PEM
# file path, or the PEM itself. Managed providers with a private root need this
# — Supabase’s pooler among them, which otherwise fails SELF_SIGNED_CERT_IN_CHAIN.
# Verification stays on either way. See infra/certs/README.md.
DATABASE_SSL_ROOT_CERT=


# -----------------------------------------------------------------------------
# Cache and queues — Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_TLS_ENABLED=false
REDIS_KEY_PREFIX=kc:local:
QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=3


# -----------------------------------------------------------------------------
# Authentication and session tokens
# -----------------------------------------------------------------------------
# Parent access/refresh tokens. Generate with: openssl rand -base64 48
# Rotate on any suspected exposure; see SECURITY.md#key-rotation.
AUTH_PROVIDER=local                         # supabase | local
AUTH_JWT_SECRET=replace-me-min-32-chars-high-entropy
AUTH_JWT_ISSUER=https://api.kidscompanion.local
AUTH_JWT_AUDIENCE=kids-companion-app
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_REFRESH_TOKEN_ROTATION=true           # reuse of a rotated token revokes the family

# Child-mode session: short-lived, device-bound, derived from a parent session.
# Children never hold long-lived credentials. See ARCHITECTURE.md#identity-model.
CHILD_SESSION_TTL=60m

# Parent gate — the "are you a grown-up?" challenge protecting settings screens.
PARENT_GATE_MODE=arithmetic                # arithmetic | device_biometric | pin
PARENT_GATE_MAX_ATTEMPTS=5
PARENT_GATE_LOCKOUT_MINUTES=15

# Password hashing (Argon2id parameters — tune per deploy target, never lower).
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_ITERATIONS=2
PASSWORD_HASH_PARALLELISM=1


# -----------------------------------------------------------------------------
# Encryption at the application layer
# -----------------------------------------------------------------------------
# Envelope encryption for the most sensitive columns (transcripts, any retained
# audio pointers). Key IDs let us re-encrypt without downtime.
ENCRYPTION_ACTIVE_KEY_ID=k1
ENCRYPTION_KEY_K1=replace-me-base64-32-byte-key
# Older keys stay available for decrypt-only during rotation:
# ENCRYPTION_KEY_K0=previous-base64-32-byte-key


# -----------------------------------------------------------------------------
# Object storage — audio and generated media
# -----------------------------------------------------------------------------
# `memory` is a real implementation but the bytes live in ONE process: audio does
# not survive a restart, is not shared between instances, and the retention sweep
# cannot run from the worker -- it would mark the ledger while the bytes stayed
# alive in the API's heap. REFUSED IN PRODUCTION.
#
# `s3` is any S3-compatible endpoint: AWS, Cloudflare R2, MinIO, or Supabase
# Storage via its S3-compatible endpoint.
STORAGE_PROVIDER=memory                    # memory | s3
STORAGE_BUCKET_AUDIO=child-audio
STORAGE_BUCKET_MEDIA=public-media
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Read only when STORAGE_PROVIDER=s3. THE ACCESS KEYS ARE SECRETS -- they are
# scoped to a bucket of children's voice recordings. They never leave the server:
# there is no presigned URL anywhere in this codebase and no bucket credential
# ever reaches a device.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_SESSION_TOKEN=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_TIMEOUT_MS=10000


# -----------------------------------------------------------------------------
# AI provider (services/ai) — swappable behind a port
# -----------------------------------------------------------------------------
# The DEPLOYMENT DEFAULT. A parent may pick any provider whose key is set below,
# from the account screen; this is what they get when they have not picked, or
# picked one whose key has since been removed. It never selects the safety
# classifier — moderation always runs on this provider, whatever a family chose.
AI_PROVIDER=anthropic                      # anthropic | openai | google | mock
AI_MODEL_CONVERSATION=claude-sonnet-5
AI_MODEL_SAFETY_CLASSIFIER=claude-haiku-4-5-20251001
AI_MAX_OUTPUT_TOKENS=512
AI_TEMPERATURE=0.7
AI_REQUEST_TIMEOUT_MS=15000
AI_MODERATION_TIMEOUT_MS=4000              # classifier runs twice per turn, so keep it tight

# Roughly the last ten exchanges, per the product specification. Configurable
# rather than hard-coded: the right number trades conversational memory against
# cost and latency, and is an empirical question per age group.
AI_CONTEXT_MAX_EXCHANGES=10
AI_CONTEXT_MAX_HISTORY_TOKENS=2000
AI_MAX_RETRIES=2

# A key here does two things: it makes that vendor selectable by AI_PROVIDER,
# and it makes it selectable by a PARENT in the account screen. Leave a vendor's
# key blank to keep it off the list entirely.
ANTHROPIC_API_KEY=replace-me
OPENAI_API_KEY=
# Google AI Studio. Has a genuine free tier, which is why it is here: with this
# key alone the whole loop runs against a real vendor at no cost. Defaults to
# gemini-2.5-flash / gemini-2.5-flash-lite when the model vars above are unset.
GOOGLE_AI_API_KEY=

# Hard spend guard. When the daily ceiling trips the API degrades to a cached
# "let's talk later" response rather than serving an unbounded bill.
AI_DAILY_COST_CEILING_USD=50
AI_PER_CHILD_DAILY_TURN_LIMIT=300


# -----------------------------------------------------------------------------
# Voice providers (services/voice) — STT and TTS behind separate ports
# -----------------------------------------------------------------------------
# Deepgram and ElevenLabs each serve BOTH halves of the loop, so either can be
# named on either side — including the same one on both, which is the
# single-vendor setup:
#
#   STT_PROVIDER=deepgram    TTS_PROVIDER=deepgram      (Nova + Aura)
#   STT_PROVIDER=elevenlabs  TTS_PROVIDER=elevenlabs    (Scribe + ElevenLabs)
#   STT_PROVIDER=deepgram    TTS_PROVIDER=elevenlabs    (the original split)
#
# Two variables rather than one VOICE_PROVIDER on purpose: the two are chosen on
# different criteria (Urdu child-speech accuracy against voice character and
# per-character pricing) and ADR-0004 separates them deliberately.
#
# google | azure | openai are listed but NOT implemented. Naming one falls back
# to the mock and warns at boot.
STT_PROVIDER=mock                          # deepgram | elevenlabs | google | azure | openai | mock
# Overrides the vendor default (deepgram: nova-2-general, elevenlabs: scribe_v1).
STT_MODEL=
STT_LANGUAGE_HINTS=en-US,ur-PK
STT_TIMEOUT_MS=10000
VOICE_MAX_UPLOAD_BYTES=8388608
VOICE_MAX_DURATION_MS=30000
VOICE_MIN_DURATION_MS=250
VOICE_ALLOW_UNKNOWN_DURATION=true
VOICE_MIN_CONFIDENCE=0.4
VOICE_TRANSIENT_AUDIO_SECONDS=300
SPEECH_ANALYSIS_PROVIDER=mock
SPEECH_ANALYSIS_TIMEOUT_MS=10000
DEEPGRAM_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS_JSON=       # base64 of the service-account JSON
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

TTS_PROVIDER=mock                          # elevenlabs | deepgram | google | azure | mock
# Overrides the vendor default (elevenlabs: eleven_turbo_v2_5, deepgram:
# aura-2-thalia-en). On Aura the model IS the voice — there is no second axis —
# so this is also the fallback voice for a character with none configured.
TTS_MODEL=
TTS_TIMEOUT_MS=10000
TTS_CACHE_TTL_SECONDS=604800               # 7d — cache synthesised audio by content hash
ELEVENLABS_API_KEY=


# -----------------------------------------------------------------------------
# Content safety
# -----------------------------------------------------------------------------
SAFETY_MODE=strict                         # strict | standard  (strict is the default; see docs/CHILD_SAFETY.md)
SAFETY_INPUT_CLASSIFIER_ENABLED=true
SAFETY_OUTPUT_CLASSIFIER_ENABLED=true
SAFETY_BLOCKLIST_VERSION=2026-08-01
SAFETY_FAIL_MODE=closed                    # closed = block on classifier error. Never set to `open`.
SAFETY_ESCALATION_WEBHOOK_URL=             # on-call route for disclosure/self-harm signals
SAFETY_REVIEW_QUEUE_ENABLED=true


# -----------------------------------------------------------------------------
# Payments (services/payments) — swappable behind a port
# -----------------------------------------------------------------------------
RATE_LIMIT_CHECKOUT_PER_HOUR=20            # checkout sessions a parent may open per hour

PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=mock                     # stripe | mock — mock is refused outside local/ci
PAYMENTS_DEFAULT_CURRENCY=PKR
PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=300     # how old a signed webhook may be
# The mock rail's HMAC key. Local and CI only; a real rail brings its own.
PAYMENTS_MOCK_WEBHOOK_SECRET=local-mock-webhook-signing-key

# International — Stripe (web checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# Which rails are switched on. EMPTY IS VALID and means payments are off —
# every family is on the free tier and the app works normally.
PAYMENTS_ENABLED_RAILS=
# Rails whose wire format a person has verified against the provider's own
# documentation AND sandbox. A deployed environment refuses to run an enabled
# rail that is not on this list. Do not add one you have not checked.
PAYMENTS_VERIFIED_RAILS=
PAYMENTS_SANDBOX_CALLBACK_SECRET=local-sandbox-rail-signing-key
PAYMENTS_RECONCILE_AFTER_MINUTES=15

# Pakistan rails.
#
# CREDENTIALS ONLY. Nothing here describes how a request is signed or where it
# is sent — those come from each provider's documentation and none has been
# verified. See docs/PAYMENT_RAILS.md before switching any of these to live.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_MODE=sandbox                      # sandbox | live
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_MODE=sandbox                     # sandbox | live

# Carrier billing, through an aggregator. None chosen — see Q-02.
CARRIER_BILLING_AGGREGATOR=
CARRIER_BILLING_MERCHANT_ID=
CARRIER_BILLING_API_KEY=
CARRIER_BILLING_CALLBACK_SECRET=
CARRIER_BILLING_MODE=sandbox               # sandbox | live

# Cards. The processor collects card details on the device; this application
# never receives a card number and has nowhere to put one.
CARD_PROCESSOR=
CARD_SECRET_KEY=
CARD_WEBHOOK_SECRET=
CARD_MODE=sandbox                          # sandbox | live

# App-store billing. Digital subscriptions sold inside the mobile app must use
# these rails per store policy — see docs/OPEN_QUESTIONS.md#Q-02.
# Which stores are switched on. EMPTY IS VALID — the app works normally
# without them and every family is on the free tier.
STORE_BILLING_ENABLED_STORES=
# Stores whose adapter a person has verified against the store's own current
# documentation AND sandbox. A deployed environment refuses to boot otherwise.
STORE_BILLING_VERIFIED_STORES=
STORE_BILLING_PROVIDER=mock                # live | mock — mock is refused in a deployed env
STORE_BILLING_MOCK_SECRET=local-store-notification-key
STORE_BILLING_ENVIRONMENT=sandbox          # sandbox | production
STORE_BILLING_SYNC_AFTER_HOURS=24

# ═══════════════════════════════════════════════════════════════════════════
# NONE OF THE CREDENTIALS BELOW IS EVER SHIPPED IN THE MOBILE APPLICATION.
# ═══════════════════════════════════════════════════════════════════════════
# The app receives a purchase token from the store SDK and sends it to this
# server. The server holds the keys that verify it. A key in an app bundle is a
# key an attacker has — both stores' verification APIs are server-to-server for
# exactly this reason. See docs/STORE_BILLING.md.
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=
APPLE_IAP_SHARED_SECRET=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=          # base64 of the service-account JSON
GOOGLE_PLAY_NOTIFICATION_TOPIC=


# -----------------------------------------------------------------------------
# Free tier and quotas
# -----------------------------------------------------------------------------
FREE_TIER_DAILY_MINUTES=10
FREE_TIER_CHILD_PROFILE_LIMIT=1
FREE_TIER_STORY_LIMIT_PER_WEEK=3
PAID_TIER_CHILD_PROFILE_LIMIT=4


# -----------------------------------------------------------------------------
# Rate limiting and abuse control
# -----------------------------------------------------------------------------
# COUNTED IN REDIS when REDIS_URL is set, so N instances enforce ONE limit
# rather than N of them. Without Redis the limiter counts in each process and
# every number below is multiplied by the instance count -- including the auth
# one, which is what makes online password guessing impractical.
#
# If Redis becomes unreachable the limiter falls back to per-instance counting
# rather than allowing or refusing everything, and logs `control:
# rate_limit_store` at error. That is worth alerting on in your log platform.
RATE_LIMIT_GLOBAL_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_15_MIN=10
RATE_LIMIT_CONVERSATION_PER_MINUTE=30
RATE_LIMIT_CONVERSATION_START_PER_HOUR=30
RATE_LIMIT_VOICE_PER_MINUTE=15
RATE_LIMIT_PRACTICE_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20
# The unauthenticated payment-webhook endpoints. Generous: a rail catching up
# after an outage delivers in bursts, and limiting a legitimate backlog into
# failure is worse than the load. Configuration rather than a literal, so it can
# be lowered during an incident without a release.
RATE_LIMIT_WEBHOOK_PER_MINUTE=600


# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kids-companion-api
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true
METRICS_PORT=9464

# -----------------------------------------------------------------------------
# Error tracking
# -----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION (a provider must be named). `none` still aggregates in
# process and still fills the operator console -- it only means nothing leaves
# the building, and that a restart loses the aggregate.
#
# NOTE: there is deliberately NO SENTRY SDK in this repository. An error
# tracker's default integrations capture request bodies, headers and cookies,
# and the request body on the busiest route here is a child speaking. The
# envelope is written by hand so nothing can attach anything unchosen.
# See apps/api/src/error-tracking.ts.
ERROR_TRACKING_PROVIDER=none              # none | sentry | webhook
SENTRY_DSN=                               # required when provider=sentry
ERROR_TRACKING_WEBHOOK_URL=               # required when provider=webhook
ERROR_TRACKING_TIMEOUT_MS=5000
# The shortest gap between two sends of the SAME fingerprint. The first
# occurrence always goes; a failure repeating a thousand times a minute is still
# one bug, and forwarding each one makes our incident the tracker's incident.
ERROR_TRACKING_RESEND_AFTER_MS=300000

# -----------------------------------------------------------------------------
# Where an alert goes
# -----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Without it every alert -- including safety_pipeline,
# the one that means children are talking while the layer checking what reaches
# them is not working -- is a `fatal` log line that something else would have to
# notice. The log line is always written; this is the path a person sees.
#
# TREAT AS A SECRET. A Slack incoming-webhook URL is a bearer credential in path
# form: anyone holding it can post into the channel.
ALERT_WEBHOOK_URL=
# generic = a JSON body, for an Alertmanager receiver or anything in-house.
# slack   = the incoming-webhook `text` shape, which Mattermost also accepts.
ALERT_WEBHOOK_FORMAT=generic
ALERT_WEBHOOK_TIMEOUT_MS=5000
# How often conditions are evaluated. Nothing else drives this: before it
# existed, a deployment with no metrics scraper never evaluated a threshold.
ALERT_EVALUATION_INTERVAL_MS=60000

# Product analytics. MUST be event-level and pseudonymous — no transcript text,
# no child name, no raw audio. Enforced in packages/shared/analytics.
ANALYTICS_PROVIDER=none                    # posthog | none
ANALYTICS_WRITE_KEY=
ANALYTICS_ENABLED=false


# -----------------------------------------------------------------------------
# Data retention (days). 0 = do not retain. See PRIVACY.md#retention-schedule.
# -----------------------------------------------------------------------------
RETENTION_RAW_AUDIO_DAYS=0                 # default: transcribe then discard immediately
RETENTION_TRANSCRIPT_DAYS=90               # a CEILING on the per-child setting; the shorter of the two wins
RETENTION_ANALYTICS_EVENT_DAYS=395
RETENTION_AUDIT_LOG_DAYS=730
RETENTION_DELETED_ACCOUNT_GRACE_DAYS=30


# -----------------------------------------------------------------------------
# Feature flags — default OFF; flip per environment
# -----------------------------------------------------------------------------
FEATURE_MULTILINGUAL_URDU=false
FEATURE_PRONUNCIATION_PRACTICE=false
FEATURE_STORY_MODE=false
FEATURE_ROLEPLAY_MODE=false
FEATURE_PARENT_DASHBOARD=false
FEATURE_OFFLINE_MODE=false


# -----------------------------------------------------------------------------
# Parent dashboard (server-side only)
# -----------------------------------------------------------------------------
# Where the Next server reaches the API. NOT prefixed NEXT_PUBLIC_ on purpose:
# every dashboard fetch happens in a Server Component or a Server Action so the
# parent's session token is attached on the server and never enters a browser
# bundle. Points at the API's port, not the dashboard's.
API_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Client-side (PUBLIC — compiled into bundles, assume world-readable)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_ENV=local

# -----------------------------------------------------------------------------
# Background worker and readiness
# -----------------------------------------------------------------------------
# The worker runs the scheduled sweeps (subscription expiry, payment
# reconciliation, store sync). It is a SEPARATE process:
#
#   pnpm dev:worker
#
# Locally you rarely need it — the sweeps are backstops and entitlement is
# computed from timestamps whenever it is read. Run it when working on billing.
#
# EXACTLY ONE instance per environment: there is no distributed lock.
WORKER_PORT=8081
WORKER_SUBSCRIPTION_SWEEP_INTERVAL_MS=300000
WORKER_PAYMENT_RECONCILE_INTERVAL_MS=300000
WORKER_STORE_SYNC_INTERVAL_MS=3600000
WORKER_AUDIO_SWEEP_INTERVAL_MS=900000

# Retry for safety escalations that could not be routed to a human. Much shorter
# than the other sweeps: the others repair a stale number, this one repairs a
# child whose disclosure has not reached anybody yet.
WORKER_ESCALATION_RETRY_INTERVAL_MS=60000

# Rebuilds progress rollups for days whose events are newer than them. The
# backstop for conversations nobody ends — without it a parent sees zeros.
WORKER_LEARNING_ROLLUP_INTERVAL_MS=300000

# Deletes transcripts past their retention. Hourly: retention is expressed in
# days, so a shorter interval buys nothing but load -- and a longer one means a
# parent who sets retention to 0 watches their child's words sit there all day.
WORKER_TRANSCRIPT_RETENTION_INTERVAL_MS=3600000

# Per-dependency deadline for GET /ready.
READINESS_PROBE_TIMEOUT_MS=2000
