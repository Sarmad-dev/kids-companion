{
  "name": "@kids/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify backend — the only trusted tier.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run --project unit --passWithNoTests",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@kids/ai": "workspace:*",
    "@kids/analytics": "workspace:*",
    "@kids/auth": "workspace:*",
    "@kids/config": "workspace:*",
    "@kids/db": "workspace:*",
    "@kids/learning": "workspace:*",
    "@kids/payments": "workspace:*",
    "@kids/practice": "workspace:*",
    "@kids/safety": "workspace:*",
    "@kids/shared": "workspace:*",
    "@kids/types": "workspace:*",
    "@kids/validation": "workspace:*",
    "@kids/voice": "workspace:*",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12"
  }
}
