# =============================================================================
# APP_ENV=development — the shared, always-on developer environment
# =============================================================================
# This file shows the DELTA from `.env.example`. Copy the base first:
#
#   cp .env.example .env
#
# then apply the overrides below.
#
# `development` is a DEPLOYED environment, not your laptop. Your laptop is
# APP_ENV=local. The distinction matters because deployed environments enforce
# transport security and reject wildcard CORS — see packages/config/src/env.ts.
#
# Secrets come from the secret manager, never from a file. See SECURITY.md §5.
# =============================================================================

APP_ENV=development
NODE_ENV=production
LOG_LEVEL=debug

# Deployed environments require TLS to the database. The config schema rejects
# `disable` when APP_ENV is development, staging, or production.
DATABASE_SSL_MODE=require
REDIS_TLS_ENABLED=false
REDIS_KEY_PREFIX=kc:dev:

# Exact origins only. A wildcard fails validation at boot.
CORS_ALLOWED_ORIGINS=https://dev.kidscompanion.app
API_PUBLIC_URL=https://api-dev.kidscompanion.app
API_TRUST_PROXY=true

# Real providers in sandbox mode, so integration behaviour is exercised without
# production cost or production data.
AI_PROVIDER=anthropic
STT_PROVIDER=mock
TTS_PROVIDER=mock
AI_DAILY_COST_CEILING_USD=10

PAYMENTS_ENABLED=false
ANALYTICS_ENABLED=false

# Synthetic data only. No production data reaches a non-production environment.
RETENTION_RAW_AUDIO_DAYS=0
RETENTION_TRANSCRIPT_DAYS=7
