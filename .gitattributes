# Normalise line endings so Windows and CI agree.
* text=auto eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.wav binary
*.m4a binary
*.pdf binary

# Lockfiles: collapse in diffs, never merge by hand.
pnpm-lock.yaml -diff linguist-generated=true
